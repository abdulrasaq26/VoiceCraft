# Copy to .env and fill in what you actually use. Every value here is optional:
# each one also has a per-request header fallback, so the server starts and runs
# without a .env at all — you just have to supply the key from the client each
# time instead. Set them here once you are running your own instance.

# HTTP port for the static server and API proxies.
# PORT=3000

# --- Director model -------------------------------------------------------
# The Qwen director backend (see kaggle_director/). Point this at your own
# vLLM/OpenAI-compatible endpoint — a Kaggle or Colab tunnel URL works.
# Requests to /api/proxy/qwen/* are forwarded here.
# Header fallback: x-qwen-endpoint / x-qwen-key
# QWEN_API_URL=https://your-tunnel.example.com
# QWEN_API_KEY=

# NVIDIA NIM, used as the fallback chat provider when Qwen is unreachable.
# Header fallback: the request's own Authorization header.
# NVIDIA_NIM_API=

# --- Stock media providers ------------------------------------------------
# Stock footage and stills for the stock_video / stock_photo / stock_text
# beat types. Without these the director falls back to generated visuals.
# Header fallbacks: x-pixabay-key / x-pexels-key
# PIXABAY_API_KEY=
# PEXELS_API_KEY=
