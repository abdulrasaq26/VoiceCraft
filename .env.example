# Copy this file to .env and fill in ONE of the two auth options below.

# Option A — API key (simplest):
# Google Cloud Console → APIs & Services → Credentials → Create credentials → API key
GOOGLE_TTS_API_KEY=AIzaSyDeJHEBpLa274yZ0yJU9sdO2iWQxB9okbk

# Option B — Service account (recommended for production):
# Path to the service account JSON key file downloaded from Google Cloud Console.
# Leave GOOGLE_TTS_API_KEY empty to use this mode.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Image generation (optional) ---
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Enables the "Image generator" panel. Leave empty to keep it disabled.
GEMINI_API_KEY=
# Override the image model if needed (default: gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Port the web server listens on (default 3000)
# PORT=3000
