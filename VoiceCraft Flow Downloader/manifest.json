{
  "manifest_version": 3,
  "name": "VoiceCraft Flow Downloader",
  "version": "0.5.4",
  "description": "Download media from Google Flow",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/automation/host-bridge.js",
        "content/automation/event-bus.js",
        "content/automation/flow-api.js",
        "content/automation/automator-engine.js",
        "content/detection/fingerprint.js",
        "content/detection/flow-adapter.js",
        "content/detection/name-normalizer.js",
        "content/detection/media-normalizer.js",
        "content/detection/detector.js",
        "content/detection/mutation-observer.js",
        "content/detection/network-media.js",
        "content/detection/media-resolver.js",
        "content/flow-crawler/flow-crawler.js",
        "content/prompt-recovery/reference-engine.js",
        "content/prompt-recovery/flow-result-detector.js",
        "content/prompt-recovery/generation-reconciler.js",
        "content/prompt-recovery/prompt-parser.js",
        "content/prompt-recovery/prompt-normalizer.js",
        "content/prompt-recovery/similarity-engine.js",
        "content/prompt-recovery/prompt-matcher.js",
        "content/prompt-recovery/prompt-cleaner.js",
        "content/prompt-recovery/prompt-recovery-ui.js",
        "content/ui/media-item.js",
        "content/ui/media-tray.js",
        "content/ui/automator-panel.js",
        "content/index.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/ui/styles.css",
        "icons/*",
        "content/automation/flow-api-main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
